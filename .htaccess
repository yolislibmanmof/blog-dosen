# ============================================
# BLOG DOSEN - LARAGON CONFIGURATION
# ============================================

# Enable rewrite engine
RewriteEngine On

# Set default charset
AddDefaultCharset UTF-8

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to assets
RewriteCond %{REQUEST_URI} ^/assets/ [OR]
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|webp|ico|svg|woff|woff2|ttf)$ [NC]
RewriteRule ^ - [L]

# Redirect www to non-www (optional)
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# Error pages
ErrorDocument 404 /blog-dosen/index.php